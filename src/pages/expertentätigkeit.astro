---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import overviewImage from '~/assets/images/expertentaetigkeit/uebersicht1.jpg';
import vorspanntechnikImage from '~/assets/images/expertentaetigkeit/vorspanntechnik.jpg';
import verstärkungstechnikImage from '~/assets/images/expertentaetigkeit/verstaerkungstechnik.jpg';

const metadata = {
  title: 'Expertentätigkeit',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Expertentätigkeit"
    title="Spezialisierte Expertise in Bautechnik"
    subtitle="Mit über 20 Jahren ausgewiesener Erfahrung in Vorspann- und Verstärkungstechnologie stelle ich mein umfassendes Know-How zur Verfügung."
    image={{
      src: overviewImage,
      alt: 'Overview of Expertise in Construction Technology',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Meine Expertise"
    columns={2}
    items={[
      {
        title: 'Vorspanntechnik',
        description:
          'Mit 20 Jahren Erfahrung gehöre ich zu den wenigen Experten in dieser spezialisierten Branche und biete umfassende Beratung.',
        icon: 'tabler:building-bridge',
      },
      {
        title: 'Verstärkungstechnik',
        description:
          'Spezialisierte Lösungen für Biegeverstärkungen und Durchstanzverstärkungen mit Fokus auf Statik und Verträglichkeit.',
        icon: 'tabler:hammer',
      },
    ]}
  >
    <Fragment slot="content">
      <p>
        Im Bereich Vorspann- und Verstärkungstechnik bringe ich aufgrund meiner langjährigen Berufserfahrung
        ausgewiesene Erfahrung mit, welche ich gerne gewinnbringend zur Verfügung stelle. Dies beinhaltet insbesondere
        Beurteilungen und Inspektionen von vorgespannten Infrastrukturbauten sowie Verstärkungskonzepte von
        Betonkonstruktionen während der Umnutzungsphase.
      </p>
    </Fragment>
  </Features2>

  <!-- Content Widget: Vorspanntechnik ************** -->

  <Content
    isReversed
    title="Vorspanntechnik"
    items={[
      {
        title: 'Beurteilung von vorgespannten Brücken',
        description: 'Beurteilung und Zustandserfassung der eingebauten Vorspannung bei Betonbrücken.',
        icon: 'tabler:building-bridge',
      },
      {
        title: 'Schrägkabel-Brücken',
        description: 'Beurteilung und Zustandserfassung der Schrägkabel mit Handlungsempfehlungen.',
        icon: 'tabler:link',
      },
      {
        title: 'Stützverbauungen',
        description: 'Beurteilung und Zustandserfassung von Zuggliedern bei rückverankerten Stützverbauungen.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Schadenfallanalyse',
        description: 'Analyse und Begutachtung von Schadenfällen bei vorgespannten Betonbauten.',
        icon: 'tabler:alert-circle',
      },
    ]}
    image={{
      src: vorspanntechnikImage,
      alt: 'Prestressed Concrete Technology',
      fit: 'cover',
      position: 'top',
      class: 'mx-auto w-full rounded-lg bg-gray-500 shadow-lg',
    }}
  >
    <Fragment slot="content">
      <p>
        In den letzten 25 Jahren sind über 1.000 Dienstjahre an Know-How in der Ausführungsindustrie für
        Vorspanntechnologie durch Fluktuationen verloren gegangen. Mit meiner umfassenden Erfahrung helfe ich Ihnen,
        diese kritischen Herausforderungen zu meistern.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-secondary-bg dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget: Verstärkungstechnik ************** -->

  <Content
    title="Verstärkungstechnik"
    items={[
      {
        title: 'Biegeverstärkungen',
        description: 'Wirksame Lösungen für Biegeverstärkungen mit Fokus auf Statik und Verträglichkeit.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Durchstanzverstärkungen',
        description: 'Spezialisierte Lösungen zur Verstärkung des Durchstanzwiderstands bei Betonkonstruktionen.',
        icon: 'tabler:lock',
      },
      {
        title: 'Schubverstärkungen',
        description:
          'Gewährleistung, dass Verstärkungslösungen nicht nur statisch, sondern auch verträglich umgesetzt werden.',
        icon: 'tabler:circle-check',
      },
      {
        title: 'Bestandskonstruktionen',
        description: 'Optimale Lösungen für die Verstärkung von bestehenden Betonkonstruktionen und Gebäuden.',
        icon: 'tabler:building',
      },
    ]}
    image={{
      src: verstärkungstechnikImage,
      alt: 'Reinforcement Technology',
    }}
  >
    <Fragment slot="content">
      <p>
        Bei Verstärkungen von bestehenden Betonkonstruktionen werden oft Lösungen geplant und umgesetzt, die zwar die
        statischen Aspekte erfüllen, aber die Verträglichkeit ausser Acht lassen. Mit meiner Expertise werden beide
        Kriterien nachhaltig erfüllt.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-transparent dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Call to Action Widget ********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Kontaktangaben',
        href: '/impressum-kontakt',
        icon: 'tabler:arrow-right',
      },
    ]}
    title="Gerne stelle ich mein Know-How zur Verfügung"
    subtitle="Haben Sie ein Projekt, das meine Expertise benötigt? Kontaktieren Sie mich für eine Beratung."
  />
</Layout>
