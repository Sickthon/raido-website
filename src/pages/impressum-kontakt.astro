---
import Layout from '~/layouts/PageLayout.astro';
import Content from '~/components/widgets/Content.astro';
import portraitImage from '~/assets/images/Zuend_IMG_2457_bearb_Brille_korr_cropped.jpg';

const metadata = {
  title: 'Impressum und Kontakt',
};
---

<Layout metadata={metadata}>
  <Content
    id="impressum-contact"
    classes={{ container: 'py-8 md:py-10 lg:py-12' }}
    columns={2}
    items={[
      {
        title: 'E-Mail',
        icon: 'tabler:mail',
        callToAction: {
          text: 'info@raido.ch',
          href: 'mailto:info@raido.ch',
        },
      },
    ]}
    image={{
      src: portraitImage,
      alt: 'Porträt von Rainer Zünd',
      loading: 'eager',
      class: 'max-w-sm mx-auto',
    }}
  >
    <Fragment slot="content">
      <h1 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl mb-4">Impressum und Kontakt</h1>
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Raido GmbH</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <p>
          <strong>Rainer Dominik Zünd</strong><br />
          Sonnenhof 5<br />
          8355 Aadorf<br />
          Schweiz
        </p>

        <p>
          <strong>Handelsregister</strong><br />
          Firmenname: Raido GmbH<br />
          Nummer: CHE 114.869.045<br />
          Handelsregisteramt: Thurgau
        </p>
      </div>
    </Fragment>
  </Content>
</Layout>
