---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';
import portraitImage from '~/assets/images/Zuend_IMG_2480_bearb_Brille_korr_cropped.jpg';

const metadata = {
  title: 'Raido',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      { variant: 'primary', text: 'Mehr erfahren', href: getPermalink('/#kompetenzen'), icon: 'tabler:arrow-down' },
    ]}
  >
    <Fragment slot="title">
      <ul class="list-none p-0 mt-0 mb-10 space-y-10">
        <li>Management- und Prozesskompetenz</li>
        <li>Führungssupport und Coaching</li>
        <li>Expertentätigkeit</li>
      </ul>
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->

  <Features
    id="kompetenzen"
    tagline="Übersicht"
    title="Meine Kompetenzen"
    items={[
      {
        title: 'Management- & Prozesskompetenz',
        icon: 'tabler:brand-tailwind',
        callToAction: {
          text: 'Meine authentische Leadership-Qualität macht den Unterschied.<br />Gerne übernehme ich zeitlich befristet die Verantwortung einer operativen Einheit sowie der Umsetzung von ausgewählten Projekten und Prozessen.',
          href: getPermalink('/management-und-prozesskompetenz'),
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: 'Beratung & Führungssupport und Coaching',
        icon: 'tabler:list-check',
        callToAction: {
          text: 'Gerne stelle ich meine 30 Jahre Führungserfahrung zur Verfügung.<br />Respekt und Wertschätzung sind Schüsselfaktoren für eine erfolgreiche Personal- und Organisationsentwicklung.<br />Eine wertbasierte und sinnstiftende Unternehmenskultur leistet zudem eine zentrale Voraussetzung für eine erfolgreiche Unternehmenszukunft.',
          href: getPermalink('/fuerungssupport-und-coaching'),
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: 'Expertentätigkeit',
        icon: 'tabler:components',
        callToAction: {
          text: 'Im Bereich Vorspann- und Verstärkungstechnik bringe ich aufgrund meiner langjährigen Berufserfahrung ausgewiesene Erfahrung mit, welche ich gerne gewinnbringend zur Verfügung stelle. Dies beinhaltet insbesondere Beurteilungen und Inspektionen von vorgespannten Infrastrukturbauten sowie Verstärkungskonzepte von Betonkonstruktionen während der Umnutzungsphase.',
          href: getPermalink('/expertentätigkeit'),
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: 'Kontakt',
        icon: 'tabler:mail',
        callToAction: {
          text: 'So können sie mich kontaktieren.',
          href: getPermalink('/impressum-kontakt'),
          icon: 'tabler:arrow-right',
        },
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- Content Widget Über mich -->

  <Content
    id="ueber-mich"
    tagline="Über mich"
    title="Wer ich bin."
    items={[
      {
        title: 'Persönlichkeit und Arbeitsweise',
        description:
          '<ul class="list-disc pl-5 space-y-1"><li>Neutral und unabhängig</li><li>Wert- und qualitätsorientiert</li><li>Umsetzungsstarker Generalist</li><li>Authentische Leadership-Qualitäten</li><li>Lösungs- und zielorientiert mit ganzheitlicher Denkweise</li><li>Hands-on-Mentalität</li><li>30 Jahre erfolgreiche Linienerfahrung mit PnL-Verantwortung</li><li>Ergebnisorientierte Arbeitsweise mit ausgeprägter Fokussierung</li></ul>',
        icon: 'tabler:user-check',
      },
      {
        title: 'Meine Erfahrungen',
        description:
          '<ul class="list-disc pl-5 space-y-1"><li>30 Jahre Führungserfahrung bis CEO</li><li>30 Jahre Vertriebserfahrung in diversen Unternehmensfunktionen</li><li>Turnaround-Management</li><li>Organisationsentwicklung und Organisationsaufbau</li><li>Optimierung und Zusammenlegung von Produktionen</li><li>KPI-Management und Effizienzsteigerung</li><li>Change Management</li><li>Insourcing- und Outsourcing-Prozesse</li><li>Erfolgreiche Implementierung eines ERP-Systems</li></ul>',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Berufliche Meilensteine der letzten 20 Jahre',
        description:
          '<ul class="list-disc pl-5 space-y-1"><li>2006–2012: Business Unit Leiter, Nüssli Schweiz AG</li><li>2012–2018: Divisionsleiter und Mitglied der Gruppenleitung, Nüssli Group</li><li>2018–2025: CEO, Stahlton AG</li></ul>',
        icon: 'tabler:chart-line',
      },
    ]}
    image={{ src: portraitImage, alt: 'Porträt von Rainer Zünd' }}
  />

  <!-- Content Widget Kontakt -->
  <CallToAction
    classes={{ container: 'pt-0 md:pt-0 lg:pt-0' }}
    actions={[
      {
        variant: 'primary',
        text: 'Nehmen Sie Kontakt auf!',
        href: getPermalink('/impressum-kontakt'),
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Möchten Sie mehr erfahren?</Fragment>
    <Fragment slot="subtitle">
      Gerne bespreche ich Ihre Situation und mögliche nächste Schritte persönlich mit Ihnen.
    </Fragment>
  </CallToAction>
</Layout>
