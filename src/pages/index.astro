---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';
import heroBackgroundImage from '~/assets/images/Hero/hero3.jpg';
import portraitImage from '~/assets/images/Zuend_IMG_2480_bearb_Brille_korr_cropped.jpg';

const metadata = {
  title: 'Raido',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      { variant: 'primary', text: 'Mehr erfahren', href: getPermalink('/#kompetenzen'), icon: 'tabler:arrow-down' },
    ]}
  >
    <Fragment slot="title">
      <ul class="list-none p-0 mt-0 mb-10 space-y-10">
        <li>Management- und Prozesskompetenz</li>
        <li>Führungssupport und Coaching</li>
        <li>Expertentätigkeit</li>
      </ul>
    </Fragment>

    <Fragment slot="bg">
      <Image src={heroBackgroundImage} alt="" class="absolute inset-0 h-full w-full object-cover object-[50%_100%]" />
      <div class="absolute inset-0 bg-white/75 dark:bg-black/60"></div>
    </Fragment>
  </Hero>

  <!-- Features Widget *************** -->

  <Features
    id="kompetenzen"
    tagline="Übersicht"
    title="Meine Kompetenzen"
    items={[
      {
        title: 'Management- & Prozesskompetenz',
        icon: 'tabler:brand-tailwind',
        callToAction: {
          text: 'Mit authentischem Leadership und zielgerichteten Prozessen zum Unternehmenserfolg.',
          href: getPermalink('/management-und-prozesskompetenz'),
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: 'Führungssupport & Coaching',
        icon: 'tabler:list-check',
        callToAction: {
          text: '30 Jahre Führungserfahrung für wertbasierte Personal- und Organisationsentwicklung.',
          href: getPermalink('/fuerungssupport-und-coaching'),
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: 'Expertentätigkeit',
        icon: 'tabler:components',
        callToAction: {
          text: 'Langjährige Erfahrung mit Vorspanntechnik und verstärkten Betonkonstruktionen.',
          href: getPermalink('/expertentätigkeit'),
          icon: 'tabler:arrow-right',
        },
      },
      {
        title: 'Kontakt',
        icon: 'tabler:mail',
        callToAction: {
          text: 'So können sie mich kontaktieren.',
          href: getPermalink('/impressum-kontakt'),
          icon: 'tabler:arrow-right',
        },
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <!-- Content Widget Über mich -->

  <Content
    id="ueber-mich"
    tagline="Über mich"
    title="Wer ich bin."
    items={[
      {
        title: 'Persönlichkeit und Arbeitsweise',
        description:
          '<ul class="list-disc pl-5 space-y-1"><li>Neutral und unabhängig</li><li>Authentische Leadership-Qualitäten</li><li>Wert- und qualitätsorientiert</li><li>Umsetzungsstarker Generalist</li><li>30 Jahre erfolgreiche Linienerfahrung mit PnL-Verantwortung</li><li>Lösungs- und zielorientiert mit ganzheitlicher Denkweise</li><li>Ergebnisorientierte Arbeitsweise mit ausgeprägter Fokussierung</li><li>Hands-on-Mentalität</li></ul>',
        icon: 'tabler:user-check',
      },
      {
        title: 'Meine Erfahrungen',
        description:
          '<ul class="list-disc pl-5 space-y-1"><li>30 Jahre Führungserfahrung bis und mit CEO-Funktion</li><li>30 Jahre Vertriebserfahrung in diversen Unternehmensfunktionen</li><li>Turnaround-Management</li><li>Organisationsentwicklung und Organisationsaufbau</li><li>Optimierung und Zusammenlegung von Produktionen</li><li>KPI-Management und Effizienzsteigerung</li><li>Change Management</li><li>Insourcing- und Outsourcing-Prozesse</li><li>Erfolgreiche Implementierung eines ERP-Systems</li></ul>',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Berufliche Meilensteine der letzten 30 Jahre',
        description:
          '<ul class="list-none space-y-1"><li class="grid grid-cols-[5.5rem_1fr] gap-2"><span>2018–2025:</span><span>CEO, Stahlton AG</span></li><li class="grid grid-cols-[5.5rem_1fr] gap-2"><span>2012–2018:</span><span>Divisionsleiter und Mitglied der Gruppenleitung, Nüssli Group</span></li><li class="grid grid-cols-[5.5rem_1fr] gap-2"><span>2006–2012:</span><span>Business Unit Leiter, Nüssli Schweiz AG</span></li><li class="grid grid-cols-[5.5rem_1fr] gap-2"><span>2001–2006:</span><span>Leiter Vorspanntechnik, Stahlton AG</span></li><li class="grid grid-cols-[5.5rem_1fr] gap-2"><span>1997–2001:</span><span>Leiter Verstärkungstechnik, Stahlton AG</span></li></ul>',
        icon: 'tabler:chart-line',
      },
    ]}
    image={{ src: portraitImage, alt: 'Porträt von Rainer Zünd' }}
  />

  <!-- Content Widget Kontakt -->
  <CallToAction
    classes={{ container: 'pt-0 md:pt-0 lg:pt-0' }}
    actions={[
      {
        variant: 'primary',
        text: 'Nehmen Sie Kontakt auf!',
        href: getPermalink('/impressum-kontakt'),
        icon: 'tabler:arrow-right',
      },
    ]}
  >
    <Fragment slot="title">Möchten Sie mehr erfahren?</Fragment>
    <Fragment slot="subtitle">
      Gerne bespreche ich Ihre Situation und mögliche nächste Schritte persönlich mit Ihnen.
    </Fragment>
  </CallToAction>
</Layout>
