---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
const metadata = {
  title: 'Management und Prozesskompetenz',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Interim Management"
    title="Management- und Prozesskompetenz"
    subtitle="Zeitlich befristet übernehme ich gerne persönlich die erforderlichen Führungsaufgaben als CEO, COO oder Abteilungsleiter mit entsprechender Kosten- und Ergebnisverantwortung."
    image={{
      src: 'https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Management Image',
    }}
  />

  <!-- Content Widget **************** -->

  <Content
    title="Authentische Leadership-Qualitäten"
    items={[
      {
        title: '30 Jahre Erfahrung',
        description: 'Erfolgreiche Linien- und PnL-Verantwortung in verschiedenen Organisationen und Industrien.',
      },
      {
        title: 'Prozesssicherheit',
        description: 'Fokus auf durchdachte Prozessoptimierung in allen Bereichen der Organisation.',
      },
      {
        title: 'Organisationsentwicklung',
        description:
          'Gezielte Weiterentwicklung von Organisationen und deren Kompetenzen parallel zur operativen Verantwortung.',
      },
      {
        title: 'Verantwortungsvoller Umgang',
        description: 'Verantwortungsbewusster Umgang mit Unternehmensressourcen und Mitarbeitern.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Leadership Image',
    }}
  >
    <Fragment slot="content">
      <p>Bei Raido wissen Sie, mit wem Sie es zu tun haben – authentische Leadership-Qualitäten von Rainer Zünd.</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Features2 Widget ************** -->

  <Features2
    title="Projekt- und Prozessmanagement"
    subtitle="Gesamt- oder Teilverantwortung von Kunden- oder internen Unternehmensprojekten"
    tagline="Leistungen"
    columns={2}
    items={[
      {
        title: 'Zusammenlegung von Organisationen',
        description: 'Merge und Integration von verschiedenen Organisationseinheiten oder Produktionsstätten.',
        icon: 'tabler:git-merge',
      },
      {
        title: 'Prozessanalyse',
        description: 'Analyse der operativen Prozesse bezüglich deren Effizienz und Rentabilität.',
        icon: 'tabler:chart-line',
      },
      {
        title: 'Change Management',
        description: 'Gestaltung und Durchführung von organisatorischen Veränderungsprozessen.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Sales & Pricing Analysen',
        description: 'Umfassende Analysen von Sales-, Verkaufs- und Pricing-Strategien.',
        icon: 'tabler:currency-dollar',
      },
      {
        title: 'Claim Management',
        description: 'Professionelles Management von Schadenfällen im Bereich Bau und Infrastruktur.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Bestellungsänderungen im Projektgeschäft',
        description: 'Änderungs- und Nachtragsmanagement in Bau- und Industrieprojekten.',
        icon: 'tabler:adjustments',
      },
      {
        title: 'Expertentätigkeit',
        description: 'Projektbegleitung im Bereich Vorspann- und Verstärkungstechnologien in der Bauwirtschaft.',
        icon: 'tabler:building-bridge',
      },
    ]}
  />

  <!-- Call to Action Widget ********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Kontaktieren Sie mich',
        href: '/impressum-kontakt',
      },
    ]}
    title="Gerne stelle ich mein Know-How zur Verfügung"
    subtitle="Zeitlich befristet übernehme ich gerne spezifische Führungsaufgaben oder Projekte in Ihrem Unternehmen. Kontaktieren Sie mich für ein unverbindliches Gespräch."
  />
</Layout>
